{
  "name": "Morse Chrome",
  "manifest_version": 3,
  "description": "Highlight text on a page and play the morse code!",
  "version": "0.3.5",
  "permissions": [
    "contextMenus",
    "offscreen"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "menu.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
